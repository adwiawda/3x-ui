events {
    worker_connections 1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;
    sendfile        on;
    keepalive_timeout  65;

    # تشخیص مرورگر جهت هدایت به صفحه زیبای ساب
    map $http_user_agent $is_browser {
        default 0;
        "~*Mozilla" 1;
        "~*Chrome" 1;
        "~*Safari" 1;
        "~*Firefox" 1;
        "~*Edge" 1;
    }

    server {
        listen ${PORT};
        server_name _;

        root /usr/share/nginx/html;

        # ۱. مسیر لینک ساب‌اسکریپشن (Port 2096)
        location /sub/ {
            if ($is_browser = 1) {
                rewrite ^/sub/.*$ /sub.html break;
            }

            proxy_pass http://127.0.0.1:2096;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        # ۲. مسیر ترافیک کانفیگ‌ها (WebSocket Inbound - Port 2052)
        # نکته: هنگام ساخت کانفیگ در پنل، مسیر (Path) را /ws و پورت را 2052 بگذارید
        location /ws {
            proxy_pass http://127.0.0.1:2052;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        # ۳. مدیریت وب‌پنل اصلی X-UI (Port 2053)
        location / {
            proxy_pass http://127.0.0.1:2053;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;

            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
        }
    }
}
