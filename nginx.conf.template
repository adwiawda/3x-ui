events {
    worker_connections 1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;
    sendfile        on;
    keepalive_timeout  65;

    # تشخیص درخواست‌های مرورگر از نرم‌افزارها
    map $http_user_agent $is_browser {
        default 0;
        "~*Mozilla" 1;
        "~*Chrome" 1;
        "~*Safari" 1;
        "~*Firefox" 1;
        "~*Edge" 1;
    }

    server {
        listen ${PORT};
        server_name _;

        root /usr/share/nginx/html;

        # مسیر ساب‌اسکریپشن هوشمند
        location /sub/ {
            # اگر پارامتر html=false بود یا درخواست از سمت نرم‌افزار وی‌پن بود، بفرست به پنل اصلی
            if ($arg_raw = "true") {
                proxy_pass http://127.0.0.1:2096/sub/;
                break;
            }

            # اگر از مرورگر باز شد، فایل HTML متحرک اختصاصی را نشان بده
            if ($is_browser = 1) {
                rewrite ^/sub/.*$ /sub.html break;
            }

            # در غیر این صورت (کلاینت‌ها و نرم‌افزارها) مستقیم به Sub Server سنایی متصل شوند
            proxy_pass http://127.0.0.1:2096/sub/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        # پنل اصلی مدیریت
        location / {
            proxy_pass http://127.0.0.1:2053;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        # مسیر WebSocket
        location /ws {
            proxy_pass http://127.0.0.1:2082;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }
    }
}
